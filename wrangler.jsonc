{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dynasty-data",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-28",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // Holds the trimmed players list, weekly stat lines, draft data and cached trade values.
  // The namespace is created automatically on the first deploy.
  "kv_namespaces": [{ "binding": "DATA" }],
  // Daily refresh of the players list and nflverse draft data.
  "triggers": { "crons": ["0 9 * * *"] },
  "observability": { "enabled": true }
}
